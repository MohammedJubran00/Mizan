DB_HOST=localhost
DB_PORT=5432
DB_NAME=express_db
DB_USER=express_user
DB_PASSWORD=your_password_here

# URL-encode special characters in the password
DATABASE_URL="postgresql://express_user:your_password_here@localhost:5432/express_db?schema=public"

JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

PORT=3000
NODE_ENV=development

CORS_ORIGIN=*

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  LAWYER
  ASSISTANT
  MEMBER
}

enum CaseStatus {
  DRAFT
  PENDING
  OPEN
  ACTIVE
  CLOSED
  WON
  LOST
}

enum HearingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  ADJOURNED
}

enum DeadlineStatus {
  PENDING
  COMPLETED
  OVERDUE
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum BillingSource {
  INVOICE
  MANUAL
}

enum ActivityType {
  CASE_CREATED
  CASE_UPDATED
  CASE_CLOSED
  CASE_ASSIGNED
  CLIENT_ADDED
  INVOICE_CREATED
  INVOICE_PAID
  REVENUE_ADDED
  DOCUMENT_UPLOADED
  HEARING_SCHEDULED
  DEADLINE_ADDED
  DEADLINE_UPDATED
  USER_CREATED
  USER_UPDATED
  ROLE_CHANGED
  WORKSPACE_UPDATED
  NOTE
  OTHER
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships         WorkspaceMember[]
  activities          Activity[]
  assignedCases       Case[]              @relation("CaseAssignee")
  billableHourEntries BillableHourEntry[]
  manualRevenues      ManualRevenue[]

  @@map("users")
}

/// Independent SaaS tenant. All operational data is scoped by workspaceId.
model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  /// IANA timezone used for all dashboard period calculations (e.g. Asia/Riyadh).
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members             WorkspaceMember[]
  clients             Client[]
  cases               Case[]
  hearings            Hearing[]
  deadlines           Deadline[]
  invoices            Invoice[]
  activities          Activity[]
  billings            Billing[]
  manualRevenues      ManualRevenue[]
  billableHourEntries BillableHourEntry[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@index([workspaceId, role])
  @@index([workspaceId, isActive])
  @@map("workspace_members")
}

model Client {
  id             String       @id @default(uuid())
  workspaceId    String
  name           String
  email          String?
  phone          String?
  status         ClientStatus @default(ACTIVE)
  lastActivityAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cases     Case[]
  invoices  Invoice[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@map("clients")
}

model Case {
  id               String     @id @default(uuid())
  workspaceId      String
  clientId         String?
  assignedToUserId String?
  title            String
  status           CaseStatus @default(OPEN)
  practiceArea     String?
  billableHours    Decimal    @default(0) @db.Decimal(12, 2)
  openedAt         DateTime   @default(now())
  closedAt         DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client              Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignedTo          User?               @relation("CaseAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  hearings            Hearing[]
  deadlines           Deadline[]
  invoices            Invoice[]
  billableHourEntries BillableHourEntry[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, practiceArea])
  @@index([workspaceId, assignedToUserId])
  @@index([clientId])
  @@index([assignedToUserId])
  @@map("cases")
}

model Hearing {
  id          String        @id @default(uuid())
  workspaceId String
  caseId      String?
  title       String
  scheduledAt DateTime
  status      HearingStatus @default(SCHEDULED)
  location    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  case      Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, scheduledAt])
  @@index([workspaceId, status, scheduledAt])
  @@index([caseId])
  @@map("hearings")
}

model Deadline {
  id          String         @id @default(uuid())
  workspaceId String
  caseId      String?
  title       String
  dueAt       DateTime
  status      DeadlineStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  case      Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, dueAt])
  @@index([workspaceId, status, dueAt])
  @@index([caseId])
  @@map("deadlines")
}

model Invoice {
  id          String        @id @default(uuid())
  workspaceId String
  clientId    String?
  caseId      String?
  amount      Decimal       @db.Decimal(14, 2)
  currency    String        @default("USD")
  status      InvoiceStatus @default(DRAFT)
  issuedAt    DateTime      @default(now())
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case      Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  billing   Billing?

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, paidAt])
  @@index([workspaceId, issuedAt])
  @@index([clientId])
  @@index([caseId])
  @@map("invoices")
}

/// Single financial source of truth. Paid invoices and manual revenue both land here.
model Billing {
  id              String        @id @default(uuid())
  workspaceId     String
  amount          Decimal       @db.Decimal(14, 2)
  currency        String        @default("USD")
  source          BillingSource
  invoiceId       String?       @unique
  manualRevenueId String?       @unique
  occurredAt      DateTime
  description     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  manualRevenue ManualRevenue? @relation(fields: [manualRevenueId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, occurredAt])
  @@index([workspaceId, source])
  @@map("billings")
}

/// Manual revenue entry — always mirrored into Billing on create.
model ManualRevenue {
  id          String   @id @default(uuid())
  workspaceId String
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("USD")
  description String?
  occurredAt  DateTime @default(now())
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  billing   Billing?

  @@index([workspaceId])
  @@index([workspaceId, occurredAt])
  @@map("manual_revenues")
}

/// Time-entry style billable hours for period-based statistics.
model BillableHourEntry {
  id          String   @id @default(uuid())
  workspaceId String
  caseId      String?
  userId      String?
  hours       Decimal  @db.Decimal(12, 2)
  workedAt    DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  case      Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, workedAt])
  @@index([caseId])
  @@index([userId])
  @@map("billable_hour_entries")
}

model Activity {
  id          String       @id @default(uuid())
  workspaceId String
  /// Actor who performed the action (nullable for system events).
  userId      String?
  type        ActivityType @default(OTHER)
  /// Short action label / title.
  title       String
  description String?
  entityType  String?
  entityId    String?
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, type])
  @@index([userId])
  @@map("activities")
}
